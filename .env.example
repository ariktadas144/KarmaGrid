# Environment Configuration
NODE_ENV=development
PORT=3000

# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/karmagrid?schema=public

# Authentication Secrets
# Secret key used for signing Organization JWTs
JWT_ORG_SECRET=your_super_secret_org_key_here

# Secret key used for signing Volunteer JWTs
JWT_VOL_SECRET=your_super_secret_vol_key_here
